TARGET = ESGamma

INCDIR=include assetio/include ../libGyro/include ../libGyro/include/gl ../libGyro/include/kinetic /usr/include/GL /usr/include/SDL /usr/include/lua5.1
SRCDIR=source assetio/source

DEPDIR=.dep/linux
OBJDIR=obj/linux
CFLAGS = $(addprefix -I , $(INCDIR)) -DELYSIAN_ENGINE -DGYRO_PLATFORM=GYRO_PLATFORM_x86
LIBS = -lGyroLinux -llua5.1 -ltolua++5.1 -lSDL
LDFLAGS =-L../libGyro
CC = gcc
CPP=g++

all: libgyro $(TARGET)
	
.PHONY: libgyro
libgyro:
	@cd ../libGyro && make -f Makefile.linux

.PHONY: customclean
customclean:
	@cd ../libGyro && make -f Makefile.linux clean

include ../libGyro/bin/gyromake.rules

$(TARGET): ../libGyro/libGyroLinux.a $(OBJS)
	@echo Creating $@
	@$(CC) $(LDFLAGS) -o $@ $^ $(LIBS)
