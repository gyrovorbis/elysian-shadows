TARGET = ElysianShadows
INCDIR=include assetio/include ../libGyro/include ../libGyro/include/kinetic ../libGyro/include/ios lib/include
SRCDIR=source assetio/source

DEPDIR=.deps
OBJDIR=objs
CFLAGS = $(addprefix -I , $(INCDIR)) -DELYSIAN_ENGINE -DGYRO_PLATFORM=GYRO_PLATFORM_iOS
LIBS = -lGyroIOS -llua -ldl -lm -lobjc -lstdc++\
		-bind_at_load \
		-framework Foundation \
		-framework CoreFoundation \
		-framework UIKit \
		-framework QuartzCore \
		-framework OpenGLES \
		-framework CoreGraphics \
		-F/usr/share/iPhoneOS5.0.sdk/System/Library/PrivateFrameworks \
		-framework GraphicsServices \
		-w
LDFLAGS=-ObjC -L../libGyro -L./lib/ios
CC = ios-clang
CPP = ios-clang++
include ../libGyro/bin/gyromake.rules

all: $(TARGET)
	
$(TARGET): $(OBJS)
	@echo Creating $@
	@$(CC) $(LDFLAGS) -o $@ $^ $(LIBS)

.PHONY: bundle
bundle: $(TARGET)
	@echo "Bundling $(TARGET) to $(TARGET).app"
	@mkdir -p $(TARGET).app
	@mv $(TARGET) $(TARGET).app/$(TARGET)_
	@cp .info.plist $(TARGET).app/Info.plist

.PHONY: rebuild
rebuild:
	@echo "Removing obj and dep dirs"
	@rm -rf $(OBJDIR)
	@rm -rf $(DEP_DIR)

.PHONY: customclean
customclean:
	@echo "Removing $(TARGET).app"
	@rm -rf $(TARGET).app
