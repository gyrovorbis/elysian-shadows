TARGET = ../Project/bin/ESGammaDC.elf
include $(KOS_BASE)/Makefile.rules

INCDIR=include assetio/include ../libGyro/include ../libGyro/include/kinetic ../libGyro/include/dc lib/include 
SRCDIR:=source assetio/source
OBJDIR=obj/dc
DEPDIR=.dep/dc

CFLAGS = $(KOS_CFLAGS) $(addprefix -I , $(INCDIR)) -DGYRO_PLATFORM=GYRO_PLATFORM_DC -DELYSIAN_ENGINE
LIBS = -lGyroDC -llua -lpng -lz -lm $(KOS_LIBS) 
KOS_LDFLAGS+=-L../libGyro -Llib/dc/lua-5.1.4
CPP = kos-c++

all: libgyro $(TARGET)
	
.PHONY: libgyro
libgyro:
	@cd ../libGyro && make -f Makefile.dc

.PHONY: customclean
customclean:
	@cd ../libGyro && make -f Makefile.dc clean

.PHONY: load
load:
	sudo arp -s 192.168.1.112 00:d0:f1:02:b3:2d
	sudo dc-tool -t 192.168.1.112 -x $(TARGET) -c /media/tera/Dev/ESDev/Project

include ../libGyro/bin/gyromake.rules


$(TARGET): ../libGyro/libGyroDC.a $(OBJS)
	$(CPP) $(KOS_CFLAGS) -o $@ $^ $(LIBS)

