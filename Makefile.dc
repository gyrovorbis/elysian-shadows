TARGET = libGyroDC.a

INCDIR=include tools/dc/shlib include/kinetic
SRCDIR:=source source/dc tools/dc/shlib source/kinetic
OBJDIR=obj/dc
DEPDIR=.dep/dc

CFLAGS = $(KOS_CFLAGS) $(addprefix -I , $(INCDIR)) -DGYRO_PLATFORM=GYRO_PLATFORM_DC
LIBS = -lpng -lz -lm $(KOS_LIBS) 
CC = $(KOS_CC)

include bin/gyromake.rules

all: $(TARGET)

$(TARGET): $(OBJS)
	$(KOS_AR) rcs $@ $^
	
.PHONY: customclean
customclean:	
