include(ExternalProject)

set(lua52_PREFIX ${CMAKE_CURRENT_BINARY_DIR}/lua52)

set(lua52_CMAKE_ARGS
	-DCMAKE_INSTALL_PREFIX:PATH=<INSTALL_DIR>
	-DCMAKE_BUILD_TYPE=${CMAKE_BUILD_TYPE}
	-DCMAKE_TOOLCHAIN_FILE=${CMAKE_TOOLCHAIN_FILE}
	-DCMAKE_OSX_ARCHITECTURES=${CMAKE_OSX_ARCHITECTURES}
	-Wno-dev
)

ExternalProject_Add(lua52_build
	PREFIX ${lua52_PREFIX}

	DOWNLOAD_DIR ${ES_CONTRIB_DOWNLOAD_DIR}

	URL http://www.lua.org/ftp/lua-5.2.3.tar.gz
	URL_MD5 dc7f94ec6ff15c985d2d6ad0f1b35654

	PATCH_COMMAND ${CMAKE_COMMAND} -E copy_if_different ${ES_SCRIPTS_DIR}/cmake/modules/lua52.cmake <SOURCE_DIR>/CMakeLists.txt

	INSTALL_DIR ${ES_TARGET_CONTRIB_OUT_DIR}
	CMAKE_ARGS ${lua52_CMAKE_ARGS}
)

add_library(lua52 STATIC IMPORTED)
set_target_properties(lua52 PROPERTIES
	IMPORTED_LOCATION ${ES_TARGET_CONTRIB_OUT_DIR}/lib/${CMAKE_STATIC_LIBRARY_PREFIX}lua52${CMAKE_STATIC_LIBRARY_SUFFIX}
)
add_dependencies(lua52 lua52_build)
