TARGET_LIB = libGyroDroid.a

OBJDIR=obj
INCDIR=include $(NDK_ROOT)/platforms/android-9/arch-arm/usr/include
SRCDIR:=source source/droid source/glal source/soft
DEP_DIR=.deps
DEP_EXT=.ddroid
CFLAGS = $(addprefix -I , $(INCDIR))
CC=arm-linux-androideabi-gcc
CPP=arm-linux-androideabi-g++
AR=arm-linux-androideabi-ar rcs

ifeq ($(GYRO_RULES),)
	GYRO_RULES=bin/gyromake.rules
endif

include $(GYRO_RULES)

LIBS =

CFLAGS+= -O2 -Wall -DGYRO_PLATFORM=GYRO_PLATFORM_droid -g
CXXFLAGS = $(CFLAGS)
ASFLAGS = $(CFLAGS)

all: $(TARGET_LIB)

default:all

$(TARGET_LIB): $(OBJS)
	@echo Creating $@
	@$(AR) $@ $?
