Lua5_2.pro:
qmake: FORCE
	@$(QMAKE) -spec macx-clang CONFIG+=debug CONFIG+=x86_64 CONFIG+=declarative_debug CONFIG+=qml_debug -o Makefile Lua5_2.pro

qmake_all: FORCE

dist: 
	@test -d .tmp/Lua5_21.0.0 || mkdir -p .tmp/Lua5_21.0.0
	$(COPY_FILE) --parents $(SOURCES) $(DIST) .tmp/Lua5_21.0.0/ && (cd `dirname .tmp/Lua5_21.0.0` && $(TAR) Lua5_21.0.0.tar Lua5_21.0.0 && $(COMPRESS) Lua5_21.0.0.tar) && $(MOVE) `dirname .tmp/Lua5_21.0.0`/Lua5_21.0.0.tar.gz . && $(DEL_FILE) -r .tmp/Lua5_21.0.0


clean:compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


####### Sub-libraries

distclean: clean
	-$(DEL_FILE) $(TARGET) 
	-$(DEL_FILE) Makefile


check: first

