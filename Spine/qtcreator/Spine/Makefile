####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/opt/Spine/bin || mkdir -p $(INSTALL_ROOT)/opt/Spine/bin
	-$(INSTALL_FILE) "$(TARGET)" "$(INSTALL_ROOT)/opt/Spine/bin/$(TARGET)"
	$(RANLIB) "$(INSTALL_ROOT)/opt/Spine/bin/$(TARGET)"

uninstall_target: FORCE
	-$(DEL_FILE) "$(INSTALL_ROOT)/opt/Spine/bin/$(TARGET)"
	-$(DEL_DIR) $(INSTALL_ROOT)/opt/Spine/bin/ 


install:  install_target  FORCE

uninstall: uninstall_target   FORCE

FORCE:

