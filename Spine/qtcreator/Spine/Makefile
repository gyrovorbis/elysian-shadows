dist: 
	@test -d .tmp/Spine1.0.0 || mkdir -p .tmp/Spine1.0.0
	$(COPY_FILE) --parents $(DIST) .tmp/Spine1.0.0/ && (cd `dirname .tmp/Spine1.0.0` && $(TAR) Spine1.0.0.tar Spine1.0.0 && $(COMPRESS) Spine1.0.0.tar) && $(MOVE) `dirname .tmp/Spine1.0.0`/Spine1.0.0.tar.gz . && $(DEL_FILE) -r .tmp/Spine1.0.0


clean:compiler_clean 
	-$(DEL_FILE) $(OBJECTS)
	-$(DEL_FILE) *~ core *.core


distclean: clean 
	-$(DEL_FILE) $(TARGET) 
	-$(DEL_FILE) Makefile


