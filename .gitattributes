#Declare files that will always have LF (Unix style) line endings on checkout.
* text eol=lf

#Declare files that will always have LF (Unix style) end of file characters on checkout.
* text eof=lf

#Denotes all files that are truly binary and should not be modified.
*.png binary
*.bin binary
*.txt binary
*.jpg binary
*.js binary
deviceconsole binary
ios-deploy binary
*.sh binary
*.rb binary
*.spine binary
*.psd binary
*.gif binary
